---
import { loadGame, getPlayerToken } from '../../lib/game.js';
import Game from '../../components/Game.svelte';

const { code } = Astro.params;
const upperCode = code?.toUpperCase() ?? '';

const token = getPlayerToken(Astro.request);
let alreadyJoined = false;
let presetName = '';

if (token && upperCode) {
  const game = loadGame(upperCode);
  alreadyJoined = !!(game && game.players[token]);
  if (alreadyJoined && game) presetName = game.players[token]?.name ?? '';
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{upperCode} — Chocolate Lottery</title>
  <style>
    @import '../../styles/global.css';
  </style>
</head>
<body>
  <Game
    code={upperCode}
    initialToken={token}
    alreadyJoined={alreadyJoined}
    presetName={presetName}
    client:load
  />
</body>
</html>
