---
import { loadGame, getPlayerToken } from '../../lib/game.js';
import Game from '../../components/Game.svelte';

const { code } = Astro.params;
const upperCode = code?.toUpperCase() ?? '';

const token = getPlayerToken(Astro.request);
let alreadyJoined = false;

if (token && upperCode) {
  const game = loadGame(upperCode);
  alreadyJoined = !!(game && game.players[token]);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>chocolate.lottery · {upperCode}</title>
  <style>@import '../../styles/global.css';</style>
  <style>
    html, body { height: 100%; }
    body { background: var(--bg); margin: 0; }
  </style>
</head>
<body>
  <Game
    code={upperCode}
    initialToken={token}
    alreadyJoined={alreadyJoined}
    client:load
  />
</body>
</html>
