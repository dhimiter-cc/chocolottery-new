---
import '../../styles/global.css';
import { loadGame, getPlayerToken, getPlayerName } from '../../lib/game.js';
import Game from '../../components/Game.svelte';

const { code } = Astro.params;
const upperCode = code?.toUpperCase() ?? '';

const token = getPlayerToken(Astro.request);
// Name comes from the Entra session; fall back to the stored game name.
let presetName = getPlayerName(Astro.request) ?? '';
let alreadyJoined = false;

if (token && upperCode) {
  const game = await loadGame(upperCode);
  alreadyJoined = !!(game && game.players[token]);
  if (alreadyJoined && game) presetName = game.players[token]?.name ?? presetName;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{upperCode} — Chocolate Lottery</title>
</head>
<body>
  <Game
    code={upperCode}
    initialToken={token}
    alreadyJoined={alreadyJoined}
    presetName={presetName}
    client:load
  />
</body>
</html>
