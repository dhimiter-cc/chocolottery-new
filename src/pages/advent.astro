---
// The advent calendar (lib/advent.ts): 24 doors, each a little Amsterdam canal
// house, standing in a shuffled order that is the same on every screen for the
// year (lib/adventStreet.ts, drawn by AdventStreet.svelte, which the reveal's
// calendar moment uses too). Opened houses light their windows and show the prize
// and who won it; today's doors glow; the rest show the day they open. Nothing
// here is interactive: doors open at the reveal of a winning round. `?door=N`
// highlights that door's house and scrolls to it (the reveal card links here).
// Always drawn in the calendar's own theme; 404 when no theme has a calendar.
import '../styles/global.css';
import ThemeDecor from '../themes/ThemeDecor.astro';
import AdventStreet from '../components/AdventStreet.svelte';
import { adventEvent } from '../lib/advent.js';
import { adventStreet, CANAL_PATH } from '../lib/adventStreet.js';

const event = adventEvent();
const street = adventStreet();
if (!event || !street) return new Response(null, { status: 404 });
const highlight = Number(Astro.url.searchParams.get('door')) || null;
---
<!DOCTYPE html>
<html lang="en" data-theme={event.id}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{street.title} — Chocolottery</title>
</head>
<body class="advent-page">
  <ThemeDecor id={event.id} />

  <main class="advent">
    <a class="advent-back" href="/">← chocolottery</a>
    <AdventStreet {street} {highlight} />
  </main>

  <svg class="canal" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d={CANAL_PATH} />
  </svg>

  {highlight && (
    <script is:inline>
      // Bring the highlighted house into view, unless it already is.
      addEventListener('load', () => {
        const el = document.querySelector('.house.is-winner');
        if (!el) return;
        const r = el.getBoundingClientRect();
        if (r.top >= 0 && r.bottom <= innerHeight - 110) return;
        el.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    </script>
  )}
</body>
</html>

<style>
  .advent-page { padding-bottom: 0; }
  .advent { max-width: 1120px; margin: 0 auto; padding: 8px 0 160px; position: relative; z-index: 1; text-align: center; }
  .advent-back { display: inline-block; margin-top: 24px; color: var(--text-mute); text-decoration: none; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .advent :global(.advent-head) { margin-top: 10px; }

  /* The canal skyline along the bottom of the page, behind everything. */
  .canal { position: fixed; left: 0; right: 0; bottom: 0; width: 100%; height: 110px; z-index: 0; fill: var(--bg); filter: brightness(0.45); pointer-events: none; }
  @media (max-width: 560px) { .canal { height: 70px; } }
</style>
