---
import '../styles/global.css';
import GoldenTicketIsland from '../components/GoldenTicketIsland.svelte';
import { loadLeaderboard } from '../lib/game.js';
import { isEventDay } from '../lib/specialPrize.js';
import type { LeaderboardWin } from '../lib/types.js';

// The homepage is a wrapped chocolate bar: the first screen is the front of
// the wrapper, with one tear strip to open a round; scrolling turns it over to
// the back, where the facts panel and the lot codes of past rounds are printed.

const { wins } = await loadLeaderboard();
const eventDay = isEventDay();

// ── The back of the wrapper: figures from the real win history ─────────────
const rounds = wins.length;
const tracked = wins.filter((w) => (w.participants ?? 0) > 0);
const servings = tracked.reduce((n, w) => n + (w.participants ?? 0), 0);
const people = new Set<string>();
for (const w of wins) {
  if (w.name) people.add(w.name.trim().toLowerCase());
  for (const n of w.player_names ?? []) people.add(n.trim().toLowerCase());
}
const winCounts = new Map<string, number>();
for (const w of wins) if (w.name) winCounts.set(w.name, (winCounts.get(w.name) ?? 0) + 1);
const luckiest = [...winCounts.entries()].sort((a, b) => b[1] - a[1])[0] ?? null;
const biggest = tracked.reduce((m, w) => Math.max(m, w.participants ?? 0), 0);
const avgOdds = tracked.length ? servings / tracked.length : 0;

const recent: LeaderboardWin[] = [...wins].sort((a, b) => (b.timestamp ?? 0) - (a.timestamp ?? 0)).slice(0, 8);

// Printed the way a lot stamp is: in the office's own time zone, whatever
// zone the server runs in.
const TZ = 'Europe/Amsterdam';
// Three-letter months, like a real lot stamp (en-GB's "short" gives "SEPT").
const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const stampDate = (ts: number) => {
  const parts = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'numeric', timeZone: TZ }).formatToParts(new Date(ts * 1000));
  const day = parts.find((p) => p.type === 'day')?.value ?? '';
  const month = Number(parts.find((p) => p.type === 'month')?.value ?? 1);
  return `${day} ${MONTHS[month - 1]}`;
};
const stampTime = (ts: number) =>
  new Date(ts * 1000).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ });

function ago(ts: number): string {
  const s = Math.max(0, Math.floor(Date.now() / 1000) - ts);
  if (s < 3600) return `${Math.max(1, Math.round(s / 60))} min ago`;
  if (s < 86400) return `${Math.round(s / 3600)} h ago`;
  const d = Math.round(s / 86400);
  return d === 1 ? 'yesterday' : `${d} days ago`;
}

function others(w: LeaderboardWin): string {
  const rest = (w.player_names ?? []).filter((n) => n !== w.name);
  if (!rest.length) return '';
  const shown = rest.slice(0, 3).join(', ');
  return rest.length > 3 ? `${shown} +${rest.length - 3}` : shown;
}

const actionLabel = eventDay ? 'Start the event' : 'Start a round';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Chocolate Lottery</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#16051D">
</head>
<body class="wrapper-page">

<!-- ═══ The front of the wrapper ═══════════════════════════════════════════ -->
<section class="bar-front" aria-labelledby="wordmark">
  <div class="foil-end" aria-hidden="true"></div>

  <div class="sleeve">
    <div class="sleeve-rules" aria-hidden="true"></div>

    <nav class="pack-corner pack-corner-tl" aria-label="Site">
      <a href="/leaderboard" class="pack-link">Leaderboard</a>
      <button type="button" id="fairness-btn" class="pack-link">Fairness check</button>
    </nav>
    <div class="pack-corner pack-corner-tr">
      <GoldenTicketIsland client:load />
    </div>

    <div class="front-core">
      <h1 id="wordmark" class="wordmark">
        <span class="wm-line">chocolate<span class="wm-dot">.</span></span><span class="wm-line">lottery</span>
      </h1>
      <p class="front-claim">One chocolate. Many victims. Whoever finds the golden ticket takes it home.</p>

      <div class="tear" id="tear">
        <button type="button" class="tear-strip" id="create-btn" aria-expanded="false" aria-controls="tear-inside">
          <span class="tear-perf" aria-hidden="true"></span>
          <span class="tear-label">
            <span class="tear-verb">Pull to</span> <span class="tear-action">{actionLabel.toLowerCase()}</span>
          </span>
          <span class="tear-tab" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="tear-perf tear-perf-b" aria-hidden="true"></span>
        </button>

        <!-- Under the strip: the inside of the wrapper, where the round's one
             setting lives. -->
        <div class="tear-inside" id="tear-inside" inert>
          <p class="inside-q" id="timer-q">How long do people get to join before it starts itself?</p>
          <div class="inside-row">
            <div class="timer-presets" role="radiogroup" aria-labelledby="timer-q">
              <button type="button" class="timer-preset" role="radio" data-seconds="60">1 min</button>
              <button type="button" class="timer-preset" role="radio" data-seconds="120">2 min</button>
              <button type="button" class="timer-preset" role="radio" data-seconds="300">5 min</button>
              <button type="button" class="timer-preset" role="radio" data-seconds="">No timer</button>
            </div>
            <button type="button" id="create-confirm" class="btn btn-primary open-round">Open the round</button>
          </div>
          <p class="inside-foot">
            <span id="create-error" class="error" role="alert"></span>
            <button type="button" id="create-cancel" class="link-btn">Wrap it back up</button>
          </p>
        </div>
      </div>
    </div>

    <p class="pack-corner pack-corner-bl" aria-hidden="true">Net wt. 1 bar · Serves the whole office</p>
    <p class="pack-corner pack-corner-br" aria-hidden="true">Best drawn before the afternoon slump</p>
  </div>

  <div class="foil-end foil-end-b" aria-hidden="true"></div>
</section>

<!-- ═══ The back of the wrapper ════════════════════════════════════════════ -->
<main class="bar-back">
  <section class="facts" aria-labelledby="facts-title">
    <h2 id="facts-title" class="facts-title">Draw facts</h2>
    <p class="facts-serving">Servings per office <strong>{people.size} colleagues</strong></p>
    <div class="facts-rule facts-rule-heavy"></div>
    <p class="facts-amount">Amount per history</p>
    <dl class="facts-list">
      <div class="facts-row facts-row-major"><dt>Rounds drawn</dt><dd>{rounds}</dd></div>
      <div class="facts-row"><dt>Seats at the table</dt><dd>{servings}</dd></div>
      <div class="facts-row"><dt>Biggest round</dt><dd>{biggest ? `${biggest} players` : '—'}</dd></div>
      <div class="facts-row"><dt>Typical odds</dt><dd>{avgOdds ? `1 in ${avgOdds.toFixed(1)}` : '—'}</dd></div>
      <div class="facts-row facts-row-major">
        <dt>Luckiest</dt>
        <dd>{luckiest ? <>{luckiest[0]} <span class="facts-pct">{Math.round((luckiest[1] / rounds) * 100)}%*</span></> : '—'}</dd>
      </div>
      <div class="facts-row"><dt>Last draw</dt><dd>{recent[0] ? ago(recent[0].timestamp) : '—'}</dd></div>
    </dl>
    <div class="facts-rule facts-rule-heavy"></div>
    <p class="facts-foot">* Share of all wins. Suspicious? <button type="button" class="link-btn facts-link" data-open-fairness>Run the fairness check</button>.</p>
  </section>

  <section class="lots" aria-labelledby="lots-title">
    <div class="lots-head">
      <h2 id="lots-title" class="lots-title">Recent rounds</h2>
      <a href="/leaderboard" class="lots-all">Full leaderboard
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    {recent.length === 0 ? (
      <p class="lots-empty">No rounds drawn yet. Pull the strip above and start the first one.</p>
    ) : (
      <ol class="lot-list">
        {recent.map((w) => (
          <li class="lot">
            <p class="lot-code" aria-label={`Game ${w.game_code}`}>{w.game_code}</p>
            <p class="lot-stamp">
              <span>{stampDate(w.timestamp)}</span>
              <span>{stampTime(w.timestamp)}</span>
            </p>
            <div class="lot-main">
              <p class="lot-winner">{w.name}</p>
              <p class="lot-others">{others(w) ? `beat ${others(w)}` : 'played alone, somehow'}</p>
            </div>
            <p class="lot-odds">{w.participants ? <>1 in <strong>{w.participants}</strong></> : '—'}</p>
            <p class="lot-prize">{w.prize_snack ?? 'House chocolate'}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
</main>

<footer class="back-foot">
  <p>Packed in the office kitchen. No HR forms were harmed.</p>
</footer>

<!-- Fairness Check modal -->
<div id="fairness-modal" class="modal" hidden>
  <div class="modal-card fairness-modal-card">
    <div class="section-head" style="margin-bottom:16px;">
      <h2>Fairness check</h2>
      <button type="button" id="fairness-close" class="btn btn-ghost icon-btn" aria-label="Close"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
    </div>
    <p class="muted">Actual wins vs. statistically expected wins, based on how many players were in each game.</p>
    <div id="fairness-body" style="margin-top:16px;"><p class="muted center">Loading…</p></div>
    <p id="fairness-note" class="muted" style="font-size:0.8rem;margin-top:14px;"></p>
  </div>
</div>

<script>
// One module; each feature registers inside `isolate()` so one broken feature
// can't take the others down with it (an unguarded throw at the top level used
// to kill every handler registered after it).

function isolate(name: string, fn: () => void) {
  try { fn(); }
  catch (err) { console.error('[landing] "' + name + '" failed to initialise:', err); }
}

const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches === true;

// ── Start a round: the tear strip ───────────────────────────────────────────
isolate('create', () => {
  const tear    = document.getElementById('tear')!;
  const strip   = document.getElementById('create-btn') as HTMLButtonElement;
  const inside  = document.getElementById('tear-inside')!;
  const presets = Array.from(inside.querySelectorAll<HTMLButtonElement>('.timer-preset'));
  const confirm = document.getElementById('create-confirm') as HTMLButtonElement;
  const cancel  = document.getElementById('create-cancel')!;
  const errEl   = document.getElementById('create-error')!;
  const label   = confirm.textContent;
  // Seconds; '' means "No timer". Two minutes suits a room scanning a QR.
  let selected = '120';

  function highlight() {
    presets.forEach((b) => {
      const on = b.dataset.seconds === selected;
      b.classList.toggle('active', on);
      b.setAttribute('aria-checked', String(on));
    });
  }
  presets.forEach((b) => b.addEventListener('click', () => { selected = b.dataset.seconds ?? ''; highlight(); }));
  highlight();

  // The strip rips off in stop-motion frames (CSS), and the inside of the
  // wrapper is what's left behind.
  function open() {
    if (tear.classList.contains('is-open')) return;
    strip.setAttribute('aria-expanded', 'true');
    // The cream inside is laid out from page load (invisible, inert), so the
    // page never moves; the rip uncovers exactly the strip's footprint of it.
    tear.classList.add('is-tearing');
    window.setTimeout(() => {
      tear.classList.remove('is-tearing');
      tear.classList.add('is-open');
      inside.inert = false;
      presets.find((b) => b.dataset.seconds === selected)?.focus();
    }, reducedMotion ? 0 : 560);
  }

  function close() {
    tear.classList.remove('is-open');
    inside.inert = true;
    strip.setAttribute('aria-expanded', 'false');
    errEl.textContent = '';
    strip.focus();
  }

  strip.addEventListener('click', open);
  cancel.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && tear.classList.contains('is-open')) close();
  });

  confirm.addEventListener('click', async () => {
    confirm.disabled = true;
    confirm.textContent = 'Opening…';
    errEl.textContent = '';
    try {
      const res  = await fetch('/api/create', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ timer_seconds: selected === '' ? null : Number(selected) }),
      });
      const data = await res.json().catch(() => ({}));
      if (data.code) {
        window.location.assign('/game/' + encodeURIComponent(data.code));
        return;
      }
      throw new Error(data.error || 'no code returned');
    } catch {
      errEl.textContent = 'Could not open a round. Check the wifi and try again.';
      confirm.disabled = false;
      confirm.textContent = label;
    }
  });
});

// ── Fairness check ──────────────────────────────────────────────────────────
isolate('fairness', () => {
  const modal = document.getElementById('fairness-modal')!;
  const body  = document.getElementById('fairness-body')!;
  const note  = document.getElementById('fairness-note')!;
  let loaded  = false;

  async function openFairness() {
    modal.removeAttribute('hidden');
    if (loaded) return;
    body.innerHTML = '<p class="muted center">Loading…</p>';
    try {
      const res  = await fetch('/api/fairness');
      const data = await res.json();
      loaded = true;
      renderFairness(data);
    } catch {
      body.innerHTML = '<p class="error center">Could not load fairness data.</p>';
    }
  }

  function fmtMonth(m: string) {
    if (!m) return '—';
    return new Date(m + '-02').toLocaleDateString('en', { month: 'short', year: 'numeric' });
  }

  function esc(s: string) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function renderFairness(data: any) {
    if (!data.players || data.players.length === 0) {
      body.innerHTML = '<p class="muted center">No games played yet, so nothing to check.</p>';
      return;
    }

    const rows = data.players.map((p: any, i: number) => {
      const expected = p.expected_wins !== null ? p.expected_wins.toFixed(1) : '—';
      const score    = p.luck_score    !== null ? p.luck_score.toFixed(2)    : '—';
      const verdict  = p.verdict
        ? `<span class="fairness-verdict fairness-${p.verdict.class}">${esc(p.verdict.label)}</span>`
        : '<span class="fairness-verdict fairness-none">—</span>';

      const gameRows = (p.games || []).map((g: any) => `
        <div class="fg-row">
          <span class="fg-month">${fmtMonth(g.month)}</span>
          <span class="fg-players">${g.participants} players</span>
          <span class="fg-chance">1 in ${g.participants} &nbsp;·&nbsp; ${g.chance_pct}% chance</span>
          <span class="fg-result ${g.won ? 'fg-won' : 'fg-lost'}">${g.won ? 'Won' : 'Lost'}</span>
        </div>`).join('');

      const detail = p.games && p.games.length
        ? `<div class="fg-list">${gameRows}</div>`
        : '<p class="muted" style="margin:0;font-size:0.85rem;">No tracked games yet.</p>';

      return `
        <tr class="fairness-row" data-idx="${i}">
          <td><span class="fg-chevron"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> ${esc(p.name)}</td>
          <td class="tc">${p.actual_wins}</td>
          <td class="tc">${expected}</td>
          <td class="tc">${score}</td>
          <td>${verdict}</td>
        </tr>
        <tr class="fairness-detail" id="fg-detail-${i}" hidden>
          <td colspan="5"><div class="fg-detail-inner">${detail}</div></td>
        </tr>`;
    }).join('');

    body.innerHTML = `
      <table class="leaderboard fairness-table">
        <thead><tr>
          <th>Name<span class="th-sub">click a row to see game history</span></th>
          <th>Wins<span class="th-sub">times you've won</span></th>
          <th>Expected<span class="th-sub">wins chance predicts, based on how many players were in each game you played</span></th>
          <th>Luck score<span class="th-sub">your wins ÷ expected; 1.0 means perfectly average</span></th>
          <th>Verdict<span class="th-sub">our completely unbiased assessment</span></th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>`;

    body.querySelectorAll<HTMLElement>('.fairness-row').forEach((row) => {
      row.addEventListener('click', () => {
        const detail  = document.getElementById('fg-detail-' + row.dataset.idx)!;
        const opening = detail.hidden;
        detail.hidden = !opening;
        row.classList.toggle('fairness-row-open', opening);
      });
    });

    const diff = data.total_games - data.tracked_games;
    note.textContent = diff > 0
      ? `${diff} game${diff > 1 ? 's' : ''} predate participant tracking and are excluded from expected win calculations.`
      : '';
  }

  function closeFairness() { modal.setAttribute('hidden', ''); }

  document.getElementById('fairness-btn')!.addEventListener('click', openFairness);
  document.querySelectorAll('[data-open-fairness]').forEach((b) => b.addEventListener('click', openFairness));
  document.getElementById('fairness-close')!.addEventListener('click', closeFairness);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeFairness(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeFairness();
  });
});
</script>
</body>
</html>
