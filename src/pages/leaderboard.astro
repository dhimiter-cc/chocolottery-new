---
import '../styles/global.css';
import { loadLeaderboard } from '../lib/game.js';

const data = await loadLeaderboard();
const wins: any[] = data.wins ?? [];

const selectedMonth = (Astro.url.searchParams.get('month') ?? '').replace(/[^0-9-]/g, '').slice(0, 7);

const monthSet = new Set<string>();
for (const w of wins) { if (w.month) monthSet.add(w.month); }
const months = [...monthSet].sort();

const filtered = selectedMonth ? wins.filter((w: any) => w.month === selectedMonth) : wins;

// Aggregate by name
const countsMap = new Map<string, { name: string; wins: number; months: Record<string, number> }>();
for (const w of filtered) {
  const n = w.name ?? 'Unknown';
  if (!countsMap.has(n)) countsMap.set(n, { name: n, wins: 0, months: {} });
  const p = countsMap.get(n)!;
  p.wins++;
  if (w.month) p.months[w.month] = (p.months[w.month] ?? 0) + 1;
}
const counts = [...countsMap.values()].sort((a, b) => b.wins - a.wins);

// Best month per player (all-time view)
for (const c of counts) {
  const entries = Object.entries(c.months).sort((a, b) => b[1] - a[1]);
  (c as any).best_month = entries[0]?.[0] ?? null;
  (c as any).best_month_count = entries[0]?.[1] ?? 0;
}

// Prev/next month nav
let prevMonth: string | null = null;
let nextMonth: string | null = null;
if (selectedMonth && months.length) {
  const idx = months.indexOf(selectedMonth);
  if (idx > 0) prevMonth = months[idx - 1];
  if (idx < months.length - 1) nextMonth = months[idx + 1];
}

function fmtMonth(m: string) {
  if (!m) return '';
  const [year, month] = m.split('-');
  return new Date(Number(year), Number(month) - 1, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' });
}

const title = selectedMonth ? fmtMonth(selectedMonth) : 'All Time';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Leaderboard — Chocolate Lottery</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
<div class="parchment">
  <header class="masthead">
    <div>
      <h1 class="title">leaderboard</h1>
      <p class="tagline">The Chocolate Industrial Complex 🏭</p>
    </div>
    <a href="/" class="btn btn-ghost">← Back</a>
  </header>

  <div class="month-nav">
    <a class:list={['btn', 'btn-ghost', { active: !selectedMonth }]} href="/leaderboard">All time</a>
    {prevMonth && <a class="btn btn-ghost" href={`/leaderboard?month=${prevMonth}`}>← {fmtMonth(prevMonth)}</a>}
    <span class="current-month">{title}</span>
    {nextMonth && <a class="btn btn-ghost" href={`/leaderboard?month=${nextMonth}`}>{fmtMonth(nextMonth)} →</a>}
  </div>

  {months.length > 1 && (
    <div class="month-list">
      {[...months].reverse().map((m) => (
        <a class:list={['chip', { active: m === selectedMonth }]} href={`/leaderboard?month=${m}`}>{fmtMonth(m)}</a>
      ))}
    </div>
  )}

  <main class="panel leaderboard-panel">
    {counts.length === 0 ? (
      <p class="muted center" style="padding: 24px;">No wins yet. The chocolate sits, lonely, waiting for its first hero.</p>
    ) : (
      <table class="leaderboard">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Wins</th>
            {!selectedMonth && <th>Best month</th>}
          </tr>
        </thead>
        <tbody>
          {counts.map((c, i) => (
            <tr class:list={[{ 'top-rank': i === 0 }]}>
              <td class="rank">{i + 1}{i === 0 ? ' 👑' : ''}</td>
              <td>{c.name}</td>
              <td><strong>{c.wins}</strong></td>
              {!selectedMonth && (
                <td class="muted">
                  {(c as any).best_month
                    ? `${fmtMonth((c as any).best_month)} (${(c as any).best_month_count})`
                    : '—'}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </main>

  <footer class="foot">
    <a href="/">← Back to the lottery</a>
  </footer>
</div>
</body>
</html>
