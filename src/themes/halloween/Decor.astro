---
// Ambient Halloween decoration: drifting fog, the odd bat, corner cobwebs and a
// dangling spider. Only rendered while Halloween is the active theme
// (ThemeDecor.astro); styled in styles/themes/halloween.css.
//
// All of it is pointer-events:none, position:fixed, and out of layout: it can
// never push the stage around or clip a bar.

// One web, drawn as radial threads from the top-left corner plus sagging rings.
// The top-right web is the same symbol mirrored.
const R = 120;
const ANGLES = [0, 20, 45, 70, 90].map((a) => (a * Math.PI) / 180);
const at = (a: number, f: number) => [Math.cos(a) * R * f, Math.sin(a) * R * f];
const spokes = ANGLES.map((a) => {
  const [x, y] = at(a, 1);
  return `M0 0L${x.toFixed(1)} ${y.toFixed(1)}`;
}).join('');
const rings = [0.28, 0.5, 0.74, 0.98]
  .map((f) =>
    ANGLES.slice(0, -1)
      .map((a, i) => {
        const [x1, y1] = at(a, f);
        const [x2, y2] = at(ANGLES[i + 1], f);
        // Pull the midpoint toward the corner so each strand sags.
        const [cx, cy] = at((a + ANGLES[i + 1]) / 2, f * 0.84);
        return `M${x1.toFixed(1)} ${y1.toFixed(1)}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
      })
      .join(''),
  )
  .join('');
const WEB = spokes + rings;
---
<div class="hw-decor" aria-hidden="true">
  <svg width="0" height="0" style="position:absolute">
    <defs>
      <symbol id="hw-bat" viewBox="0 0 64 32">
        <path d="M29 11L30 4L32 8L34 4L35 11C42 8 52 8 62 12Q57 17 52 18Q50 22 46 20Q43 26 38 22L35 28L32 31L29 28L26 22Q21 26 18 20Q14 22 12 18Q7 17 2 12C12 8 22 8 29 11Z" />
      </symbol>
      <symbol id="hw-web" viewBox="0 0 120 120">
        <path d={WEB} fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </symbol>
    </defs>
  </svg>

  <div class="hw-fog hw-fog-a"></div>
  <div class="hw-fog hw-fog-b"></div>

  <svg class="hw-web hw-web-l"><use href="#hw-web" /></svg>
  <svg class="hw-web hw-web-r"><use href="#hw-web" /></svg>

  <div class="hw-spider">
    <svg viewBox="0 0 24 24" width="22" height="22">
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none">
        <path d="M12 12L5 6M12 12L3 11M12 12L4 17M12 12L7 21M12 12L19 6M12 12L21 11M12 12L20 17M12 12L17 21" />
      </g>
      <circle cx="12" cy="13" r="4.2" fill="currentColor" />
      <circle cx="12" cy="8.6" r="2.4" fill="currentColor" />
    </svg>
  </div>

  <span class="hw-bat hw-bat-1"><svg viewBox="0 0 64 32"><use href="#hw-bat" /></svg></span>
  <span class="hw-bat hw-bat-2"><svg viewBox="0 0 64 32"><use href="#hw-bat" /></svg></span>
  <span class="hw-bat hw-bat-3"><svg viewBox="0 0 64 32"><use href="#hw-bat" /></svg></span>
</div>
