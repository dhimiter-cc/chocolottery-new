---
// Winter ambience: a light fall of snowflakes. Only rendered while Winter is the
// active theme; styled in styles/themes/winter.css. Fixed, pointer-events:none.
const flakes = Array.from({ length: 18 }, (_, i) => ({
  left: ((i * 37) % 100) + (i % 3) * 1.3,
  size: 5 + ((i * 7) % 6),
  dur: 14 + ((i * 5) % 12),
  delay: -((i * 3.1) % 20),
  drift: ((i % 5) - 2) * 14,
}));
---
<div class="wt-decor" aria-hidden="true">
  {flakes.map((f) => (
    <i class="wt-flake" style={`left:${f.left}%;width:${f.size}px;height:${f.size}px;animation-duration:${f.dur}s;animation-delay:${f.delay}s;--drift:${f.drift}px`}></i>
  ))}
</div>
