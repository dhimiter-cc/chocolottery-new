# Microsoft Entra ID (Azure AD) sign-in. See docs/azure-setup.md for how to
# obtain these values. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# Directory (tenant) ID of your organization's Entra tenant.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the app registration.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret VALUE (not the secret ID) from Certificates & secrets.
AZURE_CLIENT_SECRET=your-client-secret-value

# Must exactly match a redirect URI registered on the app (type: Web).
# Dev: http://localhost:4321/api/auth/callback
# Prod: https://<your-domain>/api/auth/callback
AZURE_REDIRECT_URI=http://localhost:4321/api/auth/callback

# Random secret (>= 32 bytes) used to sign the session cookie and derive the
# stable per-user player token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
