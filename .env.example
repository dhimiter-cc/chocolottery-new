# ── Durable leaderboard (GitHub-backed) ──────────────────────────────────────
# Without these the app still runs, but wins live only on the host's disk —
# which is exactly how the history was lost when the Railway deployment was
# removed. Set them on Railway under Variables.

# Fine-grained personal access token, scoped to the repo below, with
# Repository permissions -> Contents: Read and write.
GITHUB_TOKEN=

# owner/repo that stores the win history.
GITHUB_REPO=dhimiter-cc/chocolottery-new

# ⚠️  MUST NOT be the branch Railway deploys from. Every win is a commit, and
# committing to the deploy branch would restart the server mid-game.
# Created automatically on first win if it doesn't exist.
GITHUB_DATA_BRANCH=chocolottery-data

# Path to the JSON file on that branch.
GITHUB_DATA_PATH=leaderboard.json

# ── Azure SSO (currently reverted — see git history) ─────────────────────────
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
# SESSION_SECRET=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Sound pack, theme, event dates, new-game defaults and the outing date are set
# there. Without ADMIN_PASSWORD the dashboard does not exist in production (404);
# in dev it is open.
ADMIN_PASSWORD=

# Every save is a commit of settings.json on this branch (same repo and token as
# the leaderboard), so the branch history is the log of who changed what, and a
# fresh deploy picks the settings back up.
# ⚠️  MUST NOT be the branch Railway deploys from. Created automatically.
GITHUB_SETTINGS_BRANCH=chocolottery-settings
GITHUB_SETTINGS_PATH=settings.json

# ── Event theme override ─────────────────────────────────────────────────────
# Normally the look follows each event's date window (src/themes). The admin
# dashboard can force a theme too and wins over this. Set this to force one on
# or off at the ops level: an event id (halloween, winter) or `default`. Leave
# empty to follow the schedule. A visitor's ?theme= wins over both.
THEME=
