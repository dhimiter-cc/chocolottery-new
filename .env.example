# ── Durable leaderboard (GitHub-backed) ──────────────────────────────────────
# Without these the app still runs, but wins live only on the host's disk —
# which is exactly how the history was lost when the Railway deployment was
# removed. Set them on Railway under Variables.

# Fine-grained personal access token, scoped to the repo below, with
# Repository permissions -> Contents: Read and write.
GITHUB_TOKEN=

# owner/repo that stores the win history.
GITHUB_REPO=dhimiter-cc/chocolottery-new

# ⚠️  MUST NOT be the branch Railway deploys from. Every win is a commit, and
# committing to the deploy branch would restart the server mid-game.
# Created automatically on first win if it doesn't exist.
GITHUB_DATA_BRANCH=chocolottery-data

# Path to the JSON file on that branch.
GITHUB_DATA_PATH=leaderboard.json

# ── Azure SSO (currently reverted — see git history) ─────────────────────────
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
# SESSION_SECRET=
